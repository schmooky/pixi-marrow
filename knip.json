{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": ["scripts/*.mjs"],
      "project": ["scripts/**/*.mjs"]
    },
    "packages/pixi-marrow": {
      "entry": ["src/index.ts", "src/core.ts", "src/optimize.ts", "tests/**/*.test.ts"],
      "project": ["src/**/*.ts", "tests/**/*.ts"],
      "ignoreDependencies": ["spine-pixi-4.2", "spine-pixi-4.3"]
    }
  }
}
