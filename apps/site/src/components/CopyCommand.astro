---
interface Props {
    command: string;
}
const { command } = Astro.props;
---

<button type="button" class="copy-cmd" data-command={command} aria-label={`Copy "${command}"`}>
    <span>$</span>
    <code>{command}</code>
    <span data-copy-state>Copy</span>
</button>
<script>
    for (const button of document.querySelectorAll<HTMLButtonElement>('.copy-cmd')) {
        const state = button.querySelector('[data-copy-state]');

        button.addEventListener('click', async () => {
            try {
                await navigator.clipboard.writeText(button.dataset.command ?? '');
            } catch {
                return;
            }
            if (state === null) return;
            state.textContent = 'Copied';
            setTimeout(() => {
                state.textContent = 'Copy';
            }, 1600);
        });
    }
</script>
