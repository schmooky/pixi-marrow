---
import { DOCS_LINKS, SITE, TOOL_LINKS } from '../lib/site';

/*
 * The bar at the top of every page of the docs. On a wide screen it shows the parts of the docs as
 * tabs, and the tools apart from them on the right. On a phone the parts and the tools move into
 * a menu that opens under the bar, each with a line on what it holds.
 */

const path = Astro.url.pathname;
const github =
    'M12 .5a11.5 11.5 0 0 0-3.64 22.41c.58.1.79-.25.79-.56v-2c-3.2.7-3.88-1.37-3.88-1.37-.53-1.33-1.28-1.69-1.28-1.69-1.05-.72.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.73-1.55-2.55-.29-5.24-1.28-5.24-5.69 0-1.26.45-2.29 1.19-3.1-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.17 1.18a11 11 0 0 1 5.77 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.11 3.05.74.81 1.19 1.84 1.19 3.1 0 4.42-2.7 5.4-5.26 5.68.41.36.78 1.07.78 2.16v3.2c0 .31.21.67.8.56A11.5 11.5 0 0 0 12 .5Z';
/** An outline icon for each tool: a play button for the playground, a flask for the lab. */
const TOOL_ICONS: Record<string, string> = {
    '/playground/': 'M5 3.5h14a1.5 1.5 0 0 1 1.5 1.5v14a1.5 1.5 0 0 1-1.5 1.5H5A1.5 1.5 0 0 1 3.5 19V5A1.5 1.5 0 0 1 5 3.5ZM10 8.5v7l5.5-3.5Z',
    '/lab/': 'M9 3h6M10 3v6.5l-5.2 8.7A1.8 1.8 0 0 0 6.4 21h11.2a1.8 1.8 0 0 0 1.6-2.8L14 9.5V3M7.2 15h9.6',
};
---

<header class="nav">
    <div class="container-page nav-row">
        <a href="/" class="nav-brand">
            <svg class="nav-mark" viewBox="0 0 32 32" aria-hidden="true">
                <defs>
                    <linearGradient id="nav-mark-fill" x1="0" y1="0" x2="1" y2="1">
                        <stop offset="0" stop-color="#ffd60a" />
                        <stop offset="0.45" stop-color="#ff9f0a" />
                        <stop offset="1" stop-color="#ff375f" />
                    </linearGradient>
                </defs>
                <rect width="32" height="32" rx="8" fill="#18181b" />
                <path d="M9 23V9l7 9 7-9v14" fill="none" stroke="url(#nav-mark-fill)" stroke-width="3.2" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
            <span>pixi-<span class="marrow-text">marrow</span></span>
        </a>
        <a href={SITE.npm} class="nav-version" title="The version on npm">{SITE.version}</a>
        <nav aria-label="Docs" class="nav-links">
            {DOCS_LINKS.map((link) => (
                <a href={link.href} aria-current={link.current(path) ? 'page' : undefined}>{link.title}</a>
            ))}
        </nav>
        <div class="nav-tools">
            {TOOL_LINKS.map((link) => (
                <a href={link.href}>
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={TOOL_ICONS[link.href]} /></svg>
                    {link.title}
                </a>
            ))}
        </div>
        <a href={SITE.repository} class="nav-icon nav-repo">
            <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d={github} /></svg>
            <span class="sr-only">GitHub repository</span>
        </a>
        <button type="button" class="nav-icon nav-menu-button" popovertarget="nav-menu">
            <svg class="nav-menu-open" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16" /></svg>
            <svg class="nav-menu-close" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18" /></svg>
            <span class="sr-only">Menu</span>
        </button>
    </div>
    <div id="nav-menu" class="nav-menu" popover>
        <nav aria-label="Menu" class="container-page">
            <p class="nav-menu-label">Docs</p>
            <ul>
                {DOCS_LINKS.map((link) => (
                    <li>
                        <a href={link.href} aria-current={link.current(path) ? 'page' : undefined}>
                            <strong class="nav-menu-title">{link.title}</strong>
                            <span class="nav-menu-note">{link.note}</span>
                        </a>
                    </li>
                ))}
            </ul>
            <p class="nav-menu-label">Tools</p>
            <ul>
                {TOOL_LINKS.map((link) => (
                    <li>
                        <a href={link.href}>
                            <strong class="nav-menu-title">{link.title}</strong>
                            <span class="nav-menu-note">{link.note}</span>
                        </a>
                    </li>
                ))}
            </ul>
        </nav>
    </div>
</header>
