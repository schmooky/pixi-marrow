---
import Lab from '../layouts/Lab.astro';
import '../styles/playground.css';
---

<Lab title="Playground" description="Drop or choose Spine files or a folder, and every skeleton plays in pixi-marrow with its numbers.">
    <div class="pg">
        <div class="pg-stage" data-pg-canvas>
            <div class="pg-empty" data-pg-empty>
                <p class="pg-empty-title">Drop Spine files or a folder here</p>
                <p class="pg-empty-text">
                    Skeletons as .json or .skel, their atlases and page images in PNG, WebP or AVIF. Folders are fine, and an atlas finds its
                    images by name.
                </p>
                <p class="pg-empty-text">Or choose them with the buttons at the bottom. Nothing leaves this browser: it reads the files here.</p>
            </div>
        </div>
        <div class="pg-pick" data-pg-pick>
            <button type="button" class="pg-button" data-pg-choose="files">Choose files</button>
            <button type="button" class="pg-button" data-pg-choose="folder">Choose a folder</button>
            <input type="file" multiple hidden data-pg-files aria-label="Spine files" />
            <input type="file" multiple webkitdirectory hidden data-pg-folder aria-label="A folder of Spine files" />
        </div>
        <div class="pg-drop" aria-hidden="true">Drop to load</div>
    </div>
</Lab>
<script>
    import { startPlayground } from '../playground/playground';

    const canvas = document.querySelector<HTMLElement>('[data-pg-canvas]');
    const empty = document.querySelector<HTMLElement>('[data-pg-empty]');
    const pick = document.querySelector<HTMLElement>('[data-pg-pick]');
    const files = document.querySelector<HTMLInputElement>('[data-pg-files]');
    const folder = document.querySelector<HTMLInputElement>('[data-pg-folder]');

    if (canvas !== null && empty !== null && pick !== null && files !== null && folder !== null) {
        void startPlayground({ canvas, empty, pick, files, folder });
    }
</script>
