---
import CopyCommand from '../components/CopyCommand.astro';
import Snippet from '../components/Snippet.astro';
import source from '../landing/bee.ts?raw';
import Base from '../layouts/Base.astro';
import { SITE } from '../lib/site';

const arrow = 'M5 12h14M13 6l6 6-6 6';
---

<Base>
    <section class="container-page landing">
        <h1 class="landing-title">A Spine runtime for PixiJS v8</h1>
        <p class="landing-lead">Plays Spine 4.1, 4.2 and 4.3 skeletons. Here is a bee, and the code that draws it.</p>
        <div class="landing-card">
            <div class="landing-bee" data-landing-bee role="img" aria-label="The bee of the slot game Bzzz, playing its idle animation."></div>
            <div class="landing-code">
                <Snippet source={source} regions="import app draw" />
            </div>
        </div>
        <div class="landing-actions">
            <a href="/start/" class="btn btn-primary">
                Read the docs
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={arrow} /></svg>
            </a>
            <CopyCommand command={SITE.install} />
        </div>
    </section>
</Base>
<script>
    import { mountBee } from '../landing/bee';

    const host = document.querySelector<HTMLElement>('[data-landing-bee]');

    if (host !== null) void mountBee(host);
</script>
