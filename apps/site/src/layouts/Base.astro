---
import Head from '../components/Head.astro';
import Nav from '../components/Nav.astro';
import '../styles/global.css';

interface Props {
    /** The title of the page as its heading shows it. `Head` makes the title of the browser tab from it. */
    title?: string;
    description?: string;
    /** True for a page of the docs. */
    article?: boolean;
    /** True for a page that search engines must not index. */
    noindex?: boolean;
}
const { title, description, article, noindex } = Astro.props;
---

<!doctype html>
<html lang="en">
    <head>
        <Head title={title} description={description} article={article} noindex={noindex} />
    </head>
    <body>
        <a href="#content" class="skip-link">Skip to content</a>
        <Nav />
        <main id="content"><slot /></main>
        <footer class="footer">
            <div class="container-page footer-row">
                <span>Version 0.2, under the Spine Runtimes License.</span>
                <span>The bee is a symbol of the slot game Bzzz.</span>
            </div>
        </footer>
    </body>
</html>
