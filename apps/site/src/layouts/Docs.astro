---
import type { MarkdownHeading } from 'astro';
import { PAGES, pagesOf, SECTIONS, SITE } from '../lib/site';
import Base from './Base.astro';

interface Props {
    /** The frontmatter of the MDX page that uses this layout. */
    frontmatter: { title: string; description: string };
    headings?: MarkdownHeading[];
}
const { frontmatter, headings = [] } = Astro.props;
const path = Astro.url.pathname;
const index = PAGES.findIndex((page) => page.href === path);
const previous = index > 0 ? PAGES[index - 1] : undefined;
const next = index >= 0 ? PAGES[index + 1] : undefined;
const sections = headings.filter((heading) => heading.depth === 2);
const page = index >= 0 ? PAGES[index] : undefined;
---

<Base title={`${frontmatter.title} | ${SITE.name}`} description={frontmatter.description}>
    <div class="container-page docs">
        <aside class="docs-side">
            <nav aria-label="Docs">
                {SECTIONS.map((part) => (
                    <div class="docs-side-part">
                        <div class="eyebrow">{part}</div>
                        <div>
                            {pagesOf(part).map((item) => (
                                <a href={item.href} aria-current={item.href === path ? 'page' : undefined}>{item.title}</a>
                            ))}
                        </div>
                    </div>
                ))}
            </nav>
        </aside>
        <article class="docs-article prose-docs">
            <header class="docs-header">
                <div class="eyebrow">{page === undefined ? 'Docs' : page.section === 'Reference' ? 'Reference' : `${page.section}, step ${pagesOf(page.section).indexOf(page) + 1}`}</div>
                <h1 class="display-3">{frontmatter.title}</h1>
                <p class="lead">{frontmatter.description}</p>
                {page && (
                    <details class="docs-part">
                        <summary>{page.section}: {pagesOf(page.section).length} pages</summary>
                        <ol>
                            {pagesOf(page.section).map((item) => (
                                <li><a href={item.href} aria-current={item.href === path ? 'page' : undefined}>{item.title}</a></li>
                            ))}
                        </ol>
                    </details>
                )}
            </header>
            <slot />
            <nav aria-label="Previous and next page" class="pager">
                {previous && (
                    <a href={previous.href} rel="prev" class="card-link">
                        <div class="card-label">Previous</div>
                        <strong>{previous.title}</strong>
                    </a>
                )}
                {next && (
                    <a href={next.href} rel="next" class="card-link">
                        <div class="card-label">Next</div>
                        <strong>{next.title}</strong>
                    </a>
                )}
            </nav>
        </article>
        <aside class="docs-toc">
            {sections.length > 0 && (
                <nav aria-label="On this page">
                    <div class="card-label">On this page</div>
                    <ul>
                        {sections.map((heading) => (
                            <li><a href={`#${heading.slug}`}>{heading.text}</a></li>
                        ))}
                    </ul>
                </nav>
            )}
        </aside>
    </div>
</Base>
