{
  "name": "pixi-marrow",
  "version": "0.2.0",
  "description": "A fast Spine runtime for PixiJS v8 with its own pose core. Plays Spine 4.1, 4.2 and 4.3 skeletons on WebGL2 and WebGPU.",
  "license": "LicenseRef-LICENSE",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "default": "./dist/core.js"
    },
    "./optimize": {
      "types": "./dist/optimize.d.ts",
      "default": "./dist/optimize.js"
    },
    "./perf": {
      "types": "./dist/perf.d.ts",
      "default": "./dist/perf.js"
    },
    "./bake": {
      "types": "./dist/bake.d.ts",
      "default": "./dist/bake.js"
    },
    "./debug": {
      "types": "./dist/debug.d.ts",
      "default": "./dist/debug.js"
    },
    "./diagnose": {
      "types": "./dist/diagnose.d.ts",
      "default": "./dist/diagnose.js"
    },
    "./perf-rules.json": "./perf-rules.json",
    "./package.json": "./package.json"
  },
  "bin": {
    "pixi-marrow": "./bin/pixi-marrow.mjs"
  },
  "files": [
    "dist",
    "bin",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "AGENTS.md",
    "perf-rules.json",
    "skills"
  ],
  "scripts": {
    "build": "tsdown --config-loader native",
    "test": "node ../../scripts/fixtures.mjs && vitest run",
    "test:watch": "vitest",
    "test:coverage": "node ../../scripts/fixtures.mjs && vitest run --coverage",
    "parity:ref": "node ../../scripts/fixtures.mjs && vitest run --config vitest.report.config.ts",
    "memory:update": "node ../../scripts/fixtures.mjs && vitest run --config vitest.memory.config.ts",
    "typecheck": "tsc && tsc -p tsconfig.tests.json && tsc -p tsconfig.build.json",
    "prepublishOnly": "pnpm run build",
    "prepack": "node ../../scripts/stage-package-files.mjs",
    "postpack": "node ../../scripts/stage-package-files.mjs --clean"
  },
  "peerDependencies": {
    "pixi.js": "^8.23.0",
    "pixi-silk": "^1.0.1"
  },
  "devDependencies": {
    "@arethetypeswrong/core": "^0.18.5",
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "^5.1.0",
    "pixi-silk": "^1.0.2",
    "pixi.js": "^8.23.0",
    "publint": "^0.3.24",
    "spine-core-4.1": "npm:@esotericsoftware/spine-core@4.1.55",
    "spine-core-4.2": "npm:@esotericsoftware/spine-core@4.2.120",
    "spine-core-4.3": "npm:@esotericsoftware/spine-core@4.3.13",
    "spine-pixi-4.2": "npm:@esotericsoftware/spine-pixi-v8@4.2.120",
    "spine-pixi-4.3": "npm:@esotericsoftware/spine-pixi-v8@4.3.13",
    "tsdown": "^0.23.7",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "author": "schmooky",
  "homepage": "https://pixi-marrow.schmooky.dev",
  "bugs": {
    "url": "https://github.com/schmooky/pixi-marrow/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/schmooky/pixi-marrow.git",
    "directory": "packages/pixi-marrow"
  },
  "keywords": [
    "pixi",
    "pixijs",
    "pixi.js",
    "spine",
    "skeletal-animation",
    "runtime",
    "webgl",
    "webgpu",
    "typescript",
    "spine-runtime",
    "spine-runtimes",
    "spine-pixi",
    "pixi-spine",
    "pixi-v8",
    "pixijs-v8",
    "spine-animation",
    "2d-animation",
    "animation",
    "skeletal",
    "skeleton",
    "gamedev",
    "game-development",
    "html5-game",
    "slots",
    "performance"
  ],
  "peerDependenciesMeta": {
    "pixi-silk": {
      "optional": true
    }
  }
}
